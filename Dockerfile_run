# docker file used to build the teranode base run docker image.
# https://github.com/bsv-blockchain/teranode-base/blob/main/Dockerfile_run

# grpcurl is built from source rather than taken from the release tarball:
# the v1.9.4 release binaries are built with Go 1.25.0, which still carries
# CVE-2025-68121 (crypto/tls). Building with a current Go toolchain picks up
# the stdlib fixes. The floating patch tag means each rebuild gets the latest
# 1.27.x.
ARG GO_VERSION=1.27
ARG GRPCURL_VERSION=v1.9.4

FROM golang:${GO_VERSION} AS grpcurl
ARG GRPCURL_VERSION
RUN CGO_ENABLED=0 go install -trimpath \
    -ldflags "-s -w -X main.version=${GRPCURL_VERSION}" \
    github.com/fullstorydev/grpcurl/cmd/grpcurl@${GRPCURL_VERSION}

FROM ubuntu:noble
COPY --from=grpcurl /go/bin/grpcurl /usr/local/bin/grpcurl
RUN ln -s /usr/local/bin/grpcurl /usr/bin/grpcurl && \
    apt-get update && \
    apt-get install -y wget vim htop curl lsof iputils-ping net-tools dnsutils postgresql-client telnet sysstat procps netcat-openbsd && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*
